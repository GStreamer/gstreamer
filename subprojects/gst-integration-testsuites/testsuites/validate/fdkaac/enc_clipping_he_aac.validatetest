set-globals,
    pipeline_desc="audiotestsrc num-buffers=4 samplesperbuffer=500 ! audio/x-raw,format=S16LE,rate=48000,channels=2 ! fdkaacenc ! audio/mpeg,profile=he-aac-v1 ! aacparse name=parse ! avdec_aac name=dec ! fakesink"

meta,
    handles-states=true,
    args={
        "$(pipeline_desc)",
    },
    configs={
        [validateflow,
            pad=parse:src,
            record-buffers=true,
            ignored-fields="caps={codec_data}",
            logged-fields="buffer={pts, dur, meta}",
            ignored-event-types={
                tag, stream-start,
            }],
        [validateflow,
            pad=dec:src,
            record-buffers=true,
            logged-fields="buffer={pts, dur}",
            ignored-event-types={
                tag, stream-start,
            }],
    }

checkpoint,
    text="HE-AACv1, 2000 samples in: 5058 SBR delay trimmed as 2048+2048+962, 1134 padding trimmed at the end; the decoder outputs exactly 2000 samples"
play
