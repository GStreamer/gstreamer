set-globals,
    pipeline_desc="audiotestsrc num-buffers=1 samplesperbuffer=10 ! audio/x-raw,format=S16LE,rate=48000,channels=2 ! fdkaacenc ! audio/mpeg,profile=he-aac-v1 ! aacparse name=parse ! avdec_aac name=dec ! fakesink"

meta,
    handles-states=true,
    args={
        "$(pipeline_desc)",
    },
    configs={
        [validateflow,
            pad=parse:src,
            record-buffers=true,
            ignored-fields="caps={codec_data}",
            logged-fields="buffer={pts, dur, meta}",
            ignored-event-types={
                tag, stream-start,
            }],
        [validateflow,
            pad=dec:src,
            record-buffers=true,
            logged-fields="buffer={pts, dur}",
            ignored-event-types={
                tag, stream-start,
            }],
    }

checkpoint,
    text="10 samples in, less than the 5058 delay: the last frame carries both start=962 and end=1076; the decoder outputs exactly 10 samples"
play
