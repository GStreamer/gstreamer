    <record name="HipKernelModule" c:type="GstHipKernelModule" opaque="1" version="1.30" glib:type-name="GstHipKernelModule" glib:get-type="gst_hip_kernel_module_get_type" c:symbol-prefix="hip_kernel_module">
      <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">A compiled, device-specific module containing one or more kernel entry points.
The caller must keep the module alive until all submitted work has completed.</doc>
      <source-position filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthip_fwd.h"/>
      <constructor name="new_from_blob" c:identifier="gst_hip_kernel_module_new_from_blob" version="1.30" throws="1">
        <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">Loads @blob as a module for @device without runtime compilation. The caller
must provide a valid module image and keep it alive for the duration of this
call. The module does not retain @blob after this call returns.</doc>
        <source-position filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.h"/>
        <return-value transfer-ownership="full" nullable="1">
          <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">a new module, or %NULL on failure</doc>
          <type name="HipKernelModule" c:type="GstHipKernelModule*"/>
        </return-value>
        <parameters>
          <parameter name="device" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">a #GstHipDevice</doc>
            <type name="HipDevice" c:type="GstHipDevice*"/>
          </parameter>
          <parameter name="blob" transfer-ownership="none" nullable="1" allow-none="1">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">a complete precompiled module image supported by @device</doc>
            <type name="gpointer" c:type="gconstpointer"/>
          </parameter>
        </parameters>
      </constructor>
      <constructor name="new_from_source" c:identifier="gst_hip_kernel_module_new_from_source" version="1.30" throws="1">
        <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">Compiles @source and loads a module for @device. Entry points should use C
linkage. Source and options must be supported by the device's runtime compiler.</doc>
        <source-position filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.h"/>
        <return-value transfer-ownership="full" nullable="1">
          <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">a new module, or %NULL on failure</doc>
          <type name="HipKernelModule" c:type="GstHipKernelModule*"/>
        </return-value>
        <parameters>
          <parameter name="device" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">a #GstHipDevice</doc>
            <type name="HipDevice" c:type="GstHipDevice*"/>
          </parameter>
          <parameter name="source" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">NUL-terminated kernel source</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
          <parameter name="options" transfer-ownership="none" nullable="1" allow-none="1">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipkernel.cpp">compiler options</doc>
            <array length="3" zero-terminated="0" c:type="const gchar**">
              <type name="utf8"/>
