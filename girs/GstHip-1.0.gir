            <type name="HipDevice" c:type="GstHipDevice*"/>
          </parameter>
          <parameter name="external" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipmemory.cpp">external #GstMemory to import</doc>
            <type name="Gst.Memory" c:type="GstMemory*"/>
          </parameter>
          <parameter name="info" transfer-ownership="none">
