      <method name="convert_frame" c:identifier="gst_hip_converter_convert_frame" version="1.30">
        <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.cpp">Converts @in_buf into @out_buf using @stream.
The caller is responsible for buffer dependencies, lifetime management,
and recording the completion event. The converter may add resources
to @fence_data to keep them alive until GPU completion.</doc>
        <source-position filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.h"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.cpp">%TRUE on success</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="converter" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.cpp">a #GstHipConverter</doc>
            <type name="HipConverter" c:type="GstHipConverter*"/>
          </instance-parameter>
          <parameter name="in_buf" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.cpp">input buffer</doc>
            <type name="Gst.Buffer" c:type="GstBuffer*"/>
          </parameter>
          <parameter name="out_buf" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.cpp">output buffer</doc>
            <type name="Gst.Buffer" c:type="GstBuffer*"/>
          </parameter>
          <parameter name="fence_data" transfer-ownership="none">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.cpp">a #GstHipFenceData</doc>
            <type name="HipFenceData" c:type="GstHipFenceData*"/>
          </parameter>
          <parameter name="stream" transfer-ownership="none" nullable="1" allow-none="1">
            <doc xml:space="preserve" filename="../subprojects/gst-plugins-bad/gst-libs/gst/hip/gsthipconverter.cpp">a #GstHipStream</doc>
            <type name="HipStream" c:type="GstHipStream*"/>
          </parameter>
        </parameters>
      </method>
      <property name="alpha" writable="1" transfer-ownership="none" default-value="1.000000">
        <type name="gdouble" c:type="gdouble"/>
      </property>
